# Generate with: make key
OPENSTORE_API_KEY=ops_live_your_key_here

# SeaweedFS Filer gRPC address — internal Docker network only
# Format: host:port — no http:// prefix for gRPC
OPENSTORE_SEAWEEDFS_FILER_ADDR=seaweedfs:18888

# Where the SQLite database file lives — must point to a mounted volume
OPENSTORE_DB_PATH=/app/data/openstore.db

# ClamAV daemon address — internal Docker network only
OPENSTORE_CLAMAV_URL=tcp://clamav:3310
